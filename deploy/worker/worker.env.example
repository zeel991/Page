# The worker's settings on a Docker host. Copy to worker.env and fill in; never
# commit worker.env. Every name is documented in the repository's .env.example.
# The sandbox settings are fixed in compose.yaml.

# Render's external Postgres URL (add this host's IP to the database's allow-list).
DATABASE_URL=
# The same value as the API's (Render: the pager-secrets group).
PAGER_MASTER_KEY=

# The operator's GitHub App.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=

# Verifies Slack merge clicks. Without it no merge button is offered.
SLACK_SIGNING_SECRET=

# Optional: the operator's model key, for workspaces that bring none.
ANTHROPIC_API_KEY=
PAGER_MODEL=claude-opus-5

PAGER_WORKER_CONCURRENCY=2
PAGER_MAX_RUNNING_JOBS=4
# Optional: a gVisor runtime installed on this host, for a kernel boundary too.
PAGER_SANDBOX_DOCKER_RUNTIME=
