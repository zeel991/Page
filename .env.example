# ─────────────────────────────────────────────────────────────────────────────
# Pager Developer — environment configuration
# Copy to `.env` and fill in. `.env` is gitignored and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Infrastructure ───────────────────────────────────────────────────────────
# Two drivers, one schema:
#   pglite://<dir>  PostgreSQL compiled to WASM, in process. No daemon needed, so
#                   development and the evaluation suite are never blocked on
#                   infrastructure. Single-process: the API owns the data directory.
#   postgres://...  A real server. This is the production path, and what
#                   docker-compose.yml provisions.
DATABASE_URL=pglite://.pager/db
# Relative pglite paths resolve against this directory. Defaults to the repository root.
PAGER_DATA_ROOT=
# DATABASE_URL=postgres://pager:pager@localhost:5433/pager
REDIS_URL=redis://localhost:6380

# ── Reasoning model ──────────────────────────────────────────────────────────
# Powers IncidentInvestigator / FixAgent / CommunicationAgent.
ANTHROPIC_API_KEY=
PAGER_MODEL=claude-opus-5
# Optional: the model's effort setting (low | medium | high | xhigh | max). Blank: the model's default.
PAGER_MODEL_EFFORT=

# ── Arga Labs — external application twins ───────────────────────────────────
# Get from https://platform.argalabs.com  (key looks like `arga_...`)
# The SDK's own default (app.argalabs.com) serves the web app, not the API.
ARGA_BASE_URL=https://api.argalabs.com
ARGA_API_KEY=

# ── Lemma — agent tracing & evaluation ───────────────────────────────────────
# Get from https://platform.uselemma.ai  (key `lma_...`, project `proj_...`)
LEMMA_API_KEY=
LEMMA_PROJECT_ID=
LEMMA_RELEASE=0.1.0

# ── Provider routing ─────────────────────────────────────────────────────────
# Which backend each provider adapter talks to. One of: arga | local | real
#   arga  — Arga Twin Run (requires ARGA_API_KEY)
#   local — in-repo deterministic twin server (no credentials, offline tests)
#   real  — the genuine vendor API (requires that vendor's own token below)
PAGER_SOURCE_CONTROL_BACKEND=arga
PAGER_MESSAGING_BACKEND=arga
PAGER_OBSERVABILITY_BACKEND=arga

# Base URLs are normally injected at runtime from the Arga Twin Run.
# Set these only to pin an adapter at a fixed endpoint (local twin, or a vendor API).
GITHUB_BASE_URL=
SLACK_BASE_URL=
DATADOG_BASE_URL=

# ── Issue tracking and knowledge (optional) ──────────────────────────────────
# Incident tracking: jira | linear | none.  Runbooks/postmortems: notion | none.
PAGER_ISSUE_TRACKER=none
PAGER_ISSUE_TRACKER_BACKEND=arga
PAGER_KNOWLEDGE=none
PAGER_KNOWLEDGE_BACKEND=arga

# Required when the corresponding tracker is enabled.
JIRA_PROJECT_KEY=
LINEAR_TEAM_ID=
NOTION_PARENT_PAGE_ID=

JIRA_BASE_URL=
LINEAR_BASE_URL=
NOTION_BASE_URL=

# ── Real vendor credentials (only needed when a backend above is `real`) ─────
# These drive the evaluation harness and demos through the provider registry. They
# are DEVELOPMENT ONLY: the product never uses a static GitHub token. The worker
# reaches every repository through a GitHub App installation token, narrowed to that
# repository, and every other credential comes from the workspace's encrypted vault.
GITHUB_TOKEN=
SLACK_BOT_TOKEN=
DATADOG_API_KEY=
DATADOG_APP_KEY=
# Jira Cloud uses HTTP Basic with your Atlassian account email plus an API token.
JIRA_EMAIL=
JIRA_API_TOKEN=
LINEAR_API_KEY=
NOTION_TOKEN=

# ── Autonomy & safety ────────────────────────────────────────────────────────
# L0 observe | L1 investigate | L2 prepare | L3 open PR | L4 approved remediation
# | L5 pre-authorized remediation.  Default L3 — never raise without reading SECURITY.md
PAGER_AUTONOMY_LEVEL=L3

# ── Sandbox ──────────────────────────────────────────────────────────────────
# Where the watched repository's code (its tests, and any patch) is executed.
#   local  — a child process on this host, as this user. Only the environment,
#            working directory and process lifetime are contained, and the code can
#            read this worker's credentials. Refused against a real database unless
#            PAGER_ALLOW_LOCAL_SANDBOX=1 says every workspace is trusted.
#   docker — one container per command: no network, read-only root, the worker's
#            unprivileged uid, CPU/memory/pid limits, only the sandbox's directories
#            mounted. Needs a Docker daemon and the image from
#            docker/sandbox.Dockerfile. Required for open sign-up (deploy/worker).
PAGER_SANDBOX_RUNNER=local
PAGER_ALLOW_LOCAL_SANDBOX=
PAGER_SANDBOX_IMAGE=pager-sandbox:latest
# Optional OCI runtime for the sandbox containers, e.g. runsc (gVisor).
PAGER_SANDBOX_DOCKER_RUNTIME=
# Parent directory of sandboxes. With a containerised worker, a path mounted at the
# same place on the host (see deploy/worker/compose.yaml). Defaults to the OS temp dir.
PAGER_SANDBOX_ROOT=
# Installed dependency trees are cached here between incidents, keyed by the lockfile's
# hash. Defaults to a directory under the OS temp dir.
PAGER_DEPENDENCY_CACHE=

# ── Worker ───────────────────────────────────────────────────────────────────
# Jobs this process runs at once, and jobs all worker processes together may run.
PAGER_WORKER_CONCURRENCY=2
PAGER_MAX_RUNNING_JOBS=4
# Defaults to hostname:pid. Shown in /status and on each claimed job.
PAGER_WORKER_ID=
# Set to 1 to run the jobs that are due, then exit (a cron-style run).
PAGER_WORKER_ONCE=0
# The port the worker listens on (/health, /status, /slack/interactions). Hosts set it.
PORT=10000
# Development only: reach health URLs and twins on private addresses, over http.
PAGER_ALLOW_PRIVATE_HEALTH_URL=0
# Development only: point Notion and Resend at the local twin.
PAGER_NOTION_URL=
PAGER_RESEND_URL=
# Release step: `pnpm db:migrate`. Set to 1 to migrate on API boot instead
# (single-process deployments only; PGlite always migrates on boot).
PAGER_MIGRATE_ON_BOOT=0

# ── Sign-in and the console ↔ API boundary ───────────────────────────────────
# Auth.js (the console). Sign-in is GitHub only, using the Pager Developer GitHub
# App's own OAuth client, so the token is a user-to-server token.
AUTH_SECRET=
# The console's own public URL, for Auth.js callbacks. Blank in development.
AUTH_URL=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Set to true behind a proxy that terminates TLS (Render, Fly, …).
AUTH_TRUST_HOST=
# Shared by the console and the API (≥ 32 characters). The console signs one-minute
# tokens naming the user and workspace; the API re-checks the membership each call.
PAGER_SESSION_SECRET=
# The console's origin: the only origin allowed to call the API from a browser.
PAGER_WEB_ORIGIN=http://127.0.0.1:4100
# Where the console reaches the API, and where the API listens.
PAGER_API_URL=http://127.0.0.1:4000
PAGER_API_HOST=127.0.0.1
PAGER_API_PORT=4000
# Fastify log level for the API: fatal | error | warn | info | debug. Default warn.
LOG_LEVEL=
# GitHub hosts. Only changed to point sign-in at the local twin in development.
PAGER_GITHUB_WEB_URL=https://github.com
PAGER_GITHUB_API_URL=https://api.github.com
# `pnpm api:seed` only: the numeric GitHub user id that owns the seeded workspace.
PAGER_SEED_OWNER_GITHUB_ID=

# ── Tenant secrets ───────────────────────────────────────────────────────────
# Key-encryption key for integration_credentials: 32 bytes, base64
# (`openssl rand -base64 32`). Each secret gets its own data key, wrapped by this one.
# To use a KMS instead, implement KeyWrapper (packages/core/src/envelope.ts) with the
# KMS's Encrypt/Decrypt; rows record which key sealed them.
PAGER_MASTER_KEY=

# ── The operator's GitHub App ────────────────────────────────────────────────
# One app serves every workspace; each workspace installs it. From the app's
# settings page. Its OAuth client is also the sign-in client (AUTH_GITHUB_ID /
# AUTH_GITHUB_SECRET should be the same values). Enable "Request user authorization
# (OAuth) during installation" and set the setup URL to
# <console>/onboarding/github/setup, and the webhook URL to <api>/webhooks/github.
GITHUB_APP_ID=
# The PEM; literal "\n" sequences are accepted.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=

# ── The operator's Slack app ─────────────────────────────────────────────────
# One app; each workspace installs it with OAuth v2 and gets its own bot token,
# stored encrypted. Redirect URL: <console>/onboarding/slack/callback.
# Interactivity request URL: <worker>/slack/interactions.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Only changed to point at the local twin in development.
PAGER_SLACK_URL=https://slack.com

# ── Contract tests (pnpm test:contract) ─────────────────────────────────────
# Opt-in checks of the adapters against the vendors' real APIs. Each vendor is
# skipped when its variables are unset. Use sandbox accounts, not production.
CONTRACT_GITHUB_TOKEN=
CONTRACT_GITHUB_REPO=
CONTRACT_SLACK_BOT_TOKEN=
# Set both to also post one test message.
CONTRACT_SLACK_CHANNEL=
CONTRACT_SLACK_POST=0
CONTRACT_DATADOG_API_KEY=
CONTRACT_DATADOG_APP_KEY=
CONTRACT_DATADOG_SITE=https://api.datadoghq.com
CONTRACT_DATADOG_SERVICE=
CONTRACT_SENTRY_TOKEN=
CONTRACT_SENTRY_ORG=
CONTRACT_SENTRY_PROJECT=
CONTRACT_SENTRY_URL=https://sentry.io
